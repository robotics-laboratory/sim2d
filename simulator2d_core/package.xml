<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulator2d_core</name>
  <version>0.1.0</version>
  <description>2D simulator core — Ackermann kinematics, lidar, collision. No !truck-specific! dependencies.</description>
  <maintainer email="aitsyganok@yandex.ru">Andrey Tsyganok</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rosgraph_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nlohmann_json</depend>
  <depend>Boost</depend>
  <depend>model</depend>
  <depend>map</depend>
  

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>